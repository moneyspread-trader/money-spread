# ============================================================
# Money Spread - M-Pesa Daraja API Configuration
# ============================================================
# Get these from: https://developer.safaricom.co.ke/
# After creating an app on Daraja portal
# ============================================================

# --- Daraja API Credentials ---
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY_HERE
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET_HERE

# --- Pochi La Biashara / STK Push Config ---
# Your Pochi La Biashara phone number (the one that receives money)
MPESA_SHORTCODE=0748704327
MPESA_PASSKEY=YOUR_PASSKEY_HERE

# Transaction type for Pochi La Biashara:
# Use "CustomerPayBillOnline" for Paybill or "CustomerBuyGoodsOnline" for Till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# --- Callback URL ---
# This must be a PUBLIC URL (not localhost) that Safaricom can reach.
# For testing: use ngrok -> "ngrok http 3001" then paste the https URL below
# For production: your deployed server domain
CALLBACK_URL=https://YOUR-NGROK-URL.ngrok-free.app/api/mpesa/callback

# --- Exchange Rate ---
USD_TO_KES=129.90

# --- Environment: "sandbox" or "production" ---
MPESA_ENV=sandbox

# --- Server Port ---
PORT=3001
